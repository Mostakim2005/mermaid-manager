{
  "appId": "com.jgraph.drawio.desktop",
  "productName": "MermaidApp-draw.io",
  "copyright": "Copyright 2017-2026 draw.io Ltd",
  "asar": true,
  "files": [
    "**/*",
    "!**/WEB-INF{,/**}",
    "!drawio/src/main/webapp/stencils/**/*.xml",
    "!drawio/src/main/webapp/shapes{,/**}",
    "!drawio/src/main/webapp/js/diagramly{,/**}",
    "drawio/src/main/webapp/js/diagramly/{ElectronApp,DesktopLibrary}.js",
    "!drawio/src/main/webapp/js/grapheditor{,/**}",
    "!drawio/src/main/webapp/mxgraph/src{,/**}",
    "!drawio/src/main/webapp/mxgraph/mxClient.js",
    "!node_modules/@cantoo/pdf-lib/{cjs,dist,src,ts3.4}{,/**}",
    "!**/*.map"
  ],
  "directories": {
    "output": "../releases"
  },
  "npmRebuild": false,
  "publish": {
    "provider": "github",
    "owner": "Mostakim2005",
    "repo": "mermaid-manager"
  },
  "win": {
    "signtoolOptions": {
      "publisherName": ["JGraph Ltd", "draw.io Ltd"],
      "sign": "build/sign-trusted.mjs",
      "signingHashAlgorithms": ["sha256"]
    },
    "signExts": [".dll"],
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "portable": {
    "artifactName": "MermaidApp-draw.io-v${version}-Portable.exe"
  },
  "nsis": {
    "artifactName": "MermaidApp-draw.io-v${version}-Setup.exe",
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MermaidApp Studio",
    "deleteAppDataOnUninstall": false
  },
  "afterPack": "build/fuses.mjs",
  "fileAssociations": [
    {
      "ext": "drawio",
      "name": "draw.io Diagram",
      "description": "draw.io Diagram",
      "mimeType": "application/vnd.jgraph.mxfile",
      "role": "Editor"
    },
    {
      "ext": "vsdx",
      "name": "VSDX Document",
      "description": "VSDX Document",
      "mimeType": "application/vnd.visio",
      "role": "Editor"
    },
    {
      "ext": ["mmd", "mermaid"],
      "name": "Mermaid Diagram",
      "description": "Mermaid Diagram",
      "mimeType": "text/vnd.mermaid",
      "role": "Editor"
    }
  ]
}
